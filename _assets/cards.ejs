<%
// Template de listagem em cards com rotação automática (do mais novo ao
// mais antigo; a rotação percorre todos; JS em _includes/listing-cards.html).
// Atenção: sem indentação e com tags inline (<a>, <span>) abertas e fechadas
// na mesma linha: o Pandoc reprocessa este HTML como markdown.
%>
<div class="cs-rotator">
<div class="cs-cards">
<% for (const item of items) { %>
<div class="cs-card">
<% if (item.image) { %><div class="cs-card-thumb"><img src="<%- item.image %>" alt="" loading="lazy"/></div><% } %>
<% if (item.date) { %><p class="cs-card-date"><%= item.date %></p><% } %>
<h3 class="cs-card-title"><%= item.title %></h3>
<% if (item.description) { %><p class="cs-card-desc"><%= item.description %></p><% } %>
<p class="cs-card-action"><a class="cs-card-btn" href="<%- item.path.replace(/\.qmd$/, '.html') %>">Leia mais</a></p>
</div>
<% } %>
</div>
</div>
