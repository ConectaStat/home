<%
// Variante de cards.ejs para a página Cursos e Eventos: mesmos cards, mas
// divididos em dois grupos - Cursos e Eventos - a partir da categoria
// "Cursos" do front matter de cada post (ver Adaptar.md). Quem não tiver
// essa categoria cai em Eventos. Só essa página usa esta variante; as
// demais listagens continuam em cards.ejs.
// Atenção: sem indentação e com tags inline (<a>, <span>) abertas e fechadas
// na mesma linha: o Pandoc reprocessa este HTML como markdown.
//
// `item.path` vem com o separador do sistema onde o site foi renderizado: no
// Windows, "oportunidades\posts\...". O navegador até corrige a barra
// invertida sozinho, mas o HTML publicado não pode depender disso - nem sair
// diferente conforme a máquina que rodou o build. Daí o normaliza().
const normaliza = (p) => p.replace(/\\/g, "/").replace(/\.qmd$/, ".html");
const ehCurso = (item) => (item.categories || []).includes("Cursos");
const grupos = [
  { titulo: "Cursos", lista: items.filter(ehCurso) },
  { titulo: "Eventos", lista: items.filter((item) => !ehCurso(item)) },
];
%>
<% for (const grupo of grupos) { %>
<% if (grupo.lista.length) { %>
<h2><%= grupo.titulo %></h2>
<div class="cs-rotator">
<div class="cs-cards">
<% for (const item of grupo.lista) { %>
<div class="cs-card">
<% if (item.image) { %><div class="cs-card-thumb"><img src="<%- item.image %>" alt="" loading="lazy"/></div><% } %>
<% if (item.date) { %><p class="cs-card-date"><%= item.date %></p><% } %>
<h3 class="cs-card-title"><%= item.title %></h3>
<% if (item.description) { %><p class="cs-card-desc"><%= item.description %></p><% } %>
<p class="cs-card-action"><a class="cs-card-btn" href="<%- normaliza(item.path) %>">Leia mais</a></p>
</div>
<% } %>
</div>
</div>
<% } %>
<% } %>
